{
  "app-id": "io.orbitz.YouTubeDesktop",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "orbitz-youtube-wrapper",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=x11"
  ],
  "modules": [
    {
      "name": "orbitz-youtube-wrapper",
      "buildsystem": "simple",
      "build-commands": [
        "make install PREFIX=/app"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            ".flatpak-builder",
            "build-dir",
            "repo",
            "dist",
            "__pycache__"
          ]
        }
      ]
    }
  ]
}
